# runtime
.venv/
__pycache__/
*.pyc
logs/
*.pid

# large / generated binaries (kept locally, not in git)
*.mp4
*.mkv
*.avi
*.mov
*.engine
*.plan
*.onnx
*.pt
*.etlt
*.tar
*.zip
